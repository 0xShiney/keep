# Keep — TLS termination and the only public entrypoints.
#
#   app.<domain>  -> Next.js (UI + /api/v1 + raw bytes)
#   git.<domain>  -> Forgejo (smart-HTTP only; the web UI is not routed)
#
# Forgejo's own UI is deliberately not published. Administer it via
# `ssh -L 3001:forgejo:3000 admin@host` and http://localhost:3001.
#
# The caddy image is built with caddy-ratelimit (see caddy/Dockerfile); stock
# Caddy would reject the rate_limit blocks below.

{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

(app_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	import app_headers

	# Sign-in and token endpoints: slow down credential stuffing.
	@auth path /login* /api/auth/* /api/v1/tokens*
	rate_limit @auth {
		zone auth {
			key {remote_host}
			events 30
			window 1m
		}
	}

	# Writes through the BFF.
	@writes {
		method POST PUT PATCH DELETE
		path /api/v1/*
	}
	rate_limit @writes {
		zone writes {
			key {remote_host}
			events 120
			window 1m
		}
	}

	request_body {
		max_size 4MB
	}

	reverse_proxy web:3000 {
		health_uri /healthz
		health_interval 15s
		header_up X-Real-IP {remote_host}
	}
}

{$GIT_DOMAIN} {
	encode zstd gzip
	import app_headers

	# Git smart-HTTP: unauthenticated discovery is normal; brute force against
	# /user/pass is the concern, so limit per host.
	rate_limit {
		zone git {
			key {remote_host}
			events 300
			window 1m
		}
	}

	request_body {
		max_size 250MB
	}

	reverse_proxy forgejo:3000 {
		health_uri /api/healthz
		health_interval 30s
	}
}
