{
  "name": "keep",
  "version": "0.1.0",
  "private": true,
  "description": "Keep — a private, self-hosted code forge for one owner-operator.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "forgejo:spec": "node scripts/fetch-forgejo-spec.mjs",
    "forgejo:types": "node scripts/generate-forgejo-types.mjs",
    "check:public-env": "node scripts/check-public-env.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.108.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.2",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.1",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "swagger2openapi": "7.0.8",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
