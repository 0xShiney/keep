# Keep — environment configuration
#
# Copy to .env (chmod 600) and fill in. This file is the only place secrets live;
# never commit the filled copy. The compose stack reads it via env_file.
#
# Generated secrets:
#   SESSION_SECRET       node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
#   POSTGRES_PASSWORD    node -e 'console.log(require("crypto").randomBytes(24).toString("base64url"))'
#   KEEP_OWNER_PASSWORD  create a long random passphrase and store it in a password manager

# ── Public addresses ───────────────────────────────────────────────────────────
# Hostnames only (no scheme). Caddy obtains certificates for both.
APP_HOST=app.example.com
GIT_HOST=git.example.com
# Address the browser uses for the app; must match APP_HOST with https://.
APP_ORIGIN=https://app.example.com
ACME_EMAIL=you@example.com

# ── Forgejo ────────────────────────────────────────────────────────────────────
# Server-to-server base URL (compose service name). Keep this internal.
FORGEJO_INTERNAL_URL=http://forgejo:3000
# Browser-visible git origin used for OAuth redirects and clone URLs.
FORGEJO_PUBLIC_URL=https://git.example.com
GIT_PUBLIC_URL=https://git.example.com
SSH_HOST=git.example.com
SSH_PORT=2222

# Filled by deploy/forgejo/bootstrap.sh into deploy/secrets/oauth.env, then copy here.
FORGEJO_CLIENT_ID=
FORGEJO_CLIENT_SECRET=
# Dedicated admin service account used ONLY for personal-access-token operations
# (Forgejo requires HTTP Basic auth for that endpoint). bootstrap.sh creates it and
# writes the random password to deploy/secrets/oauth.env. It must NOT be the
# owner's login: Keep never stores the owner's password. Leave both empty to
# disable token management (the panel then explains why).
FORGEJO_BROKER_USER=keep-token-broker
FORGEJO_BROKER_PASSWORD=

# ── App database (the `keep` database; Forgejo has its own) ────────────────────
# Use the postgres service name; percent-encode special characters in the password.
DATABASE_URL=postgres://keep_app:CHANGE_ME@postgres:5432/keep
KEEP_DB_NAME=keep
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=CHANGE_ME

# ── Sessions and identity ──────────────────────────────────────────────────────
# >=32 chars. Rotating it signs everyone out (acceptable; sessions are cheap).
SESSION_SECRET=
# Owner login on Forgejo; grants system-level actions in Keep.
KEEP_OWNER_LOGIN=you
KEEP_OWNER_EMAIL=you@example.com
# Only used by bootstrap.sh to create the owner once; remove afterwards.
KEEP_OWNER_PASSWORD=

# ── Runtime ────────────────────────────────────────────────────────────────────
# `forgejo` for any production deployment. `fixture` serves an in-memory demo and
# is REFUSED when NODE_ENV=production; in development it requires
# KEEP_FIXTURE_ACK=1. It is never a silent fallback.
KEEP_BACKEND=forgejo
KEEP_FIXTURE_ACK=0
LOG_LEVEL=info
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=720

# ── Backups (restic) ───────────────────────────────────────────────────────────
# Any restic backend: s3:https://..., sftp:..., b2:..., rclone:...
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
